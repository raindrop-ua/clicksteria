{
  "name": "clicksteria",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:clicksteria": "node dist/clicksteria/server/server.mjs",
    "lint": "ng lint && pnpm lint:css",
    "lint:fix": "ng lint --fix && pnpm lint:css:fix",
    "lint:css": "prettier --check \"src/**/*.css\" && stylelint \"src/**/*.css\"",
    "lint:css:fix": "prettier --write \"src/**/*.css\" && stylelint \"src/**/*.css\" --fix",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.8.0",
    "eslint": "^10.9.1",
    "husky": "9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "17.5.1",
    "prettier": "^3.8.1",
    "stylelint": "18.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{js,json,md,yaml,yml}": "prettier --write"
  }
}
